# DataMind Receipts — required environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env, fill in real values, and NEVER commit .env.
# Share credentials only through a password manager, not through chat or git.
#
# Person B owns these variables (Gemma API):
# ─────────────────────────────────────────────────────────────────────────────

# API key for Google AI Studio (used to call hosted Gemma models).
# Obtain from: https://aistudio.google.com/apikey
# After judging, rotate this key.
GOOGLE_GEMMA_API_KEY=your-google-ai-studio-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Person A owns these variables (Snowflake connection):
# ─────────────────────────────────────────────────────────────────────────────

# Snowflake account identifier (e.g. xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=

# Application/service user — must have DM_READER role ONLY.
# Never configure DM_LOADER credentials here.
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Or use key-pair auth (recommended for scripted login):
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
