# ==============================================================================
# DataMind Receipts — Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# NEVER commit .env with real passwords or API keys to GitHub!
# ==============================================================================

# ── Google Gemini / Gemma 4 API Key ──────────────────────────────────────────
# Required for Gemma 4 query interpretation, SQL generation, and prose synthesis.
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# ── Snowflake Connection (DM_READER Role) ────────────────────────────────────
# The application MUST ONLY connect using the read-only DM_READER role.
# DM_LOADER or ACCOUNTADMIN credentials must NEVER be placed in production .env.
SNOWFLAKE_ACCOUNT=yqdfpyo-am55321
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DATAMIND
SNOWFLAKE_SCHEMA=OWID
SNOWFLAKE_ROLE=DM_READER

# ── Optional: DigitalOcean App Platform Token ────────────────────────────────
# DIGITALOCEAN_TOKEN=your_digitalocean_api_token
