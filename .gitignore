# ── Python runtime ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
*.key
*.pem
*.p8

# ── Test / coverage artefacts ────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.xml

# ── Build artefacts ───────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Editor and OS noise ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Frontend build (committed intentionally for one-command run) ──────────────
# web/dist/ is committed so judges need only Python, not Node.
# Uncomment to exclude if you prefer not to commit the build:
# web/dist/

# ── Temporary reference files (copied from Downloads for inspection) ──────────
handbook.html
guide.pdf

# ── Eval artefacts (results files are committed; raw outputs are not) ─────────
eval/results_raw/

# Diagnostic/scratch outputs --- never commit these
pytest_error.txt
scratch_*.py

